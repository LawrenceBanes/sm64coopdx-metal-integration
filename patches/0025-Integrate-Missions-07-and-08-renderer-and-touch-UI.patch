diff --git a/tests/gfx_texture_cache_rewind_test.c b/tests/gfx_texture_cache_rewind_test.c
new file mode 100644
index 00000000..337f6fe2
--- /dev/null
+++ b/tests/gfx_texture_cache_rewind_test.c
@@ -0,0 +1,40 @@
+#include <assert.h>
+#include <stdint.h>
+
+#include "../src/pc/gfx/gfx_texture_cache_utils.h"
+
+struct CacheNode {
+    uint32_t texture_id;
+};
+
+int main(void) {
+    struct CacheNode nodes[3] = {{7}, {19}, {42}};
+    void *hashmap[6] = { &nodes[0], &nodes[1], NULL, &nodes[2], NULL, &nodes[0] };
+    uint32_t pool_position = 3;
+
+    gfx_texture_cache_rewind(hashmap, 6, &pool_position);
+    assert(pool_position == 0);
+    for (unsigned i = 0; i < 6; ++i) assert(hashmap[i] == NULL);
+    /* Rewinding hash links preserves renderer texture slots for reuse. */
+    assert(nodes[0].texture_id == 7);
+    assert(nodes[1].texture_id == 19);
+    assert(nodes[2].texture_id == 42);
+
+    /* Model repeated raw/DynOS mod replacement: recycled CPU cache nodes may
+     * retain renderer slots, but no old hash-chain link may survive a rewind. */
+    for (uint32_t cycle = 0; cycle < 32; ++cycle) {
+        hashmap[cycle % 6] = &nodes[cycle % 3];
+        hashmap[(cycle + 2) % 6] = &nodes[(cycle + 1) % 3];
+        pool_position = 2;
+        gfx_texture_cache_rewind(hashmap, 6, &pool_position);
+        assert(pool_position == 0);
+        for (unsigned i = 0; i < 6; ++i) assert(hashmap[i] == NULL);
+    }
+    assert(nodes[0].texture_id == 7);
+    assert(nodes[1].texture_id == 19);
+    assert(nodes[2].texture_id == 42);
+
+    gfx_texture_cache_rewind(NULL, 6, &pool_position);
+    gfx_texture_cache_rewind(hashmap, 0, NULL);
+    return 0;
+}
