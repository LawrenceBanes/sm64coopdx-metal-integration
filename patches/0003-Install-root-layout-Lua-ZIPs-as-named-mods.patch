diff --git a/src/pc/mods/mod_import_zip_preflight.c b/src/pc/mods/mod_import_zip_preflight.c
index 69423ed91cc0d472c526f47c276384b545ef670b..21b0b3fde5a7ddce82580d63a72df7caacb90dcc 100644
--- a/src/pc/mods/mod_import_zip_preflight.c
+++ b/src/pc/mods/mod_import_zip_preflight.c
@@ -59,3 +59,27 @@ struct ModImportZipPreflight mod_import_zip_preflight(mz_zip_archive *archive) {
     }
     return result;
 }
+
+bool mod_import_zip_resolve_lua_folder(const struct ModImportZipPreflight *preflight,
+                                       const char *zip_path, char *out, size_t out_size) {
+    if (!preflight || preflight->error != MOD_IMPORT_ZIP_PREFLIGHT_OK || !preflight->is_lua ||
+        !zip_path || !out || out_size == 0) return false;
+
+    if (preflight->lua_path[0]) {
+        size_t length = strlen(preflight->lua_path);
+        if (length >= out_size) return false;
+        memcpy(out, preflight->lua_path, length + 1);
+        return true;
+    }
+
+    const char *base = strrchr(zip_path, '/');
+    base = base ? base + 1 : zip_path;
+    size_t base_length = strlen(base);
+    if (base_length >= 4 && strcmp(base + base_length - 4, ".zip") == 0) base_length -= 4;
+    if (base_length == 0 || base_length + 2 > out_size) return false;
+
+    memcpy(out, base, base_length);
+    out[base_length] = '/';
+    out[base_length + 1] = '\0';
+    return mod_import_zip_path_is_safe(out);
+}
