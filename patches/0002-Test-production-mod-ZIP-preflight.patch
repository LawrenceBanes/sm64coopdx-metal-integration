diff --git a/src/pc/mods/mod_import_zip_preflight.c b/src/pc/mods/mod_import_zip_preflight.c
new file mode 100644
index 0000000000000000000000000000000000000000..69423ed91cc0d472c526f47c276384b545ef670b
--- /dev/null
+++ b/src/pc/mods/mod_import_zip_preflight.c
@@ -0,0 +1,61 @@
+#include <string.h>
+
+#include "mod_import_path.h"
+#include "mod_import_zip_preflight.h"
+
+static bool has_suffix(const char *path, const char *suffix) {
+    size_t path_len = strlen(path);
+    size_t suffix_len = strlen(suffix);
+    return path_len >= suffix_len && strcmp(path + path_len - suffix_len, suffix) == 0;
+}
+
+static bool get_parent_path(const char *path, char *out, size_t out_size) {
+    const char *last_slash = strrchr(path, '/');
+    size_t length = last_slash ? (size_t)(last_slash - path + 1) : 0;
+    if (length >= out_size) return false;
+    memcpy(out, path, length);
+    out[length] = '\0';
+    return true;
+}
+
+struct ModImportZipPreflight mod_import_zip_preflight(mz_zip_archive *archive) {
+    struct ModImportZipPreflight result = { 0 };
+    mz_uint count = mz_zip_reader_get_num_files(archive);
+    if (count > MOD_IMPORT_MAX_ZIP_ENTRIES) {
+        result.error = MOD_IMPORT_ZIP_PREFLIGHT_TOO_MANY_ENTRIES;
+        return result;
+    }
+
+    mz_uint64 total_size = 0;
+    for (mz_uint i = 0; i < count; ++i) {
+        mz_zip_archive_file_stat stat;
+        result.entry_index = i;
+        if (!mz_zip_reader_file_stat(archive, i, &stat)) {
+            result.error = MOD_IMPORT_ZIP_PREFLIGHT_INVALID_ENTRY;
+            return result;
+        }
+        if (!mod_import_zip_path_is_safe(stat.m_filename)) {
+            result.error = MOD_IMPORT_ZIP_PREFLIGHT_UNSAFE_PATH;
+            return result;
+        }
+        if (stat.m_uncomp_size > MOD_IMPORT_MAX_ZIP_FILE_SIZE ||
+            total_size > MOD_IMPORT_MAX_ZIP_TOTAL_SIZE - stat.m_uncomp_size) {
+            result.error = MOD_IMPORT_ZIP_PREFLIGHT_SIZE_LIMIT;
+            return result;
+        }
+        total_size += stat.m_uncomp_size;
+
+        if (has_suffix(stat.m_filename, ".lua") || has_suffix(stat.m_filename, ".luac")) {
+            if (!result.is_lua && !get_parent_path(stat.m_filename, result.lua_path, sizeof(result.lua_path))) {
+                result.error = MOD_IMPORT_ZIP_PREFLIGHT_PATH_TOO_LONG;
+                return result;
+            }
+            result.is_lua = true;
+        } else if (has_suffix(stat.m_filename, ".tex") ||
+                   has_suffix(stat.m_filename, ".png") ||
+                   has_suffix(stat.m_filename, ".bin")) {
+            result.is_dynos = true;
+        }
+    }
+    return result;
+}
diff --git a/src/pc/mods/mod_import_zip_preflight.h b/src/pc/mods/mod_import_zip_preflight.h
new file mode 100644
index 0000000000000000000000000000000000000000..29ab1d08ad32e572d02fb2193ebd76a460805b45
--- /dev/null
+++ b/src/pc/mods/mod_import_zip_preflight.h
@@ -0,0 +1,32 @@
+#ifndef MOD_IMPORT_ZIP_PREFLIGHT_H
+#define MOD_IMPORT_ZIP_PREFLIGHT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+
+#include "pc/utils/miniz/miniz.h"
+
+#define MOD_IMPORT_MAX_ZIP_ENTRIES 16384u
+#define MOD_IMPORT_MAX_ZIP_FILE_SIZE (128u * 1024u * 1024u)
+#define MOD_IMPORT_MAX_ZIP_TOTAL_SIZE (512u * 1024u * 1024u)
+
+enum ModImportZipPreflightError {
+    MOD_IMPORT_ZIP_PREFLIGHT_OK,
+    MOD_IMPORT_ZIP_PREFLIGHT_TOO_MANY_ENTRIES,
+    MOD_IMPORT_ZIP_PREFLIGHT_INVALID_ENTRY,
+    MOD_IMPORT_ZIP_PREFLIGHT_UNSAFE_PATH,
+    MOD_IMPORT_ZIP_PREFLIGHT_SIZE_LIMIT,
+    MOD_IMPORT_ZIP_PREFLIGHT_PATH_TOO_LONG,
+};
+
+struct ModImportZipPreflight {
+    enum ModImportZipPreflightError error;
+    mz_uint entry_index;
+    bool is_lua;
+    bool is_dynos;
+    char lua_path[4096];
+};
+
+struct ModImportZipPreflight mod_import_zip_preflight(mz_zip_archive *archive);
+
+#endif
diff --git a/tests/mod_import_zip_preflight_test.c b/tests/mod_import_zip_preflight_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..4339846920f960c26eeb58b9f87e09c2aad7ab99
--- /dev/null
+++ b/tests/mod_import_zip_preflight_test.c
@@ -0,0 +1,77 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "pc/mods/mod_import_zip_preflight.h"
+
+static void make_path(char *out, size_t size, const char *label) {
+    snprintf(out, size, "/tmp/sm64coopdx-preflight-%ld-%s.zip", (long)getpid(), label);
+}
+
+static void write_zip_start(mz_zip_archive *zip, const char *path) {
+    memset(zip, 0, sizeof(*zip));
+    assert(mz_zip_writer_init_file(zip, path, 0));
+}
+
+static void write_zip_end(mz_zip_archive *zip) {
+    assert(mz_zip_writer_finalize_archive(zip));
+    assert(mz_zip_writer_end(zip));
+}
+
+static struct ModImportZipPreflight scan(const char *path) {
+    mz_zip_archive zip = { 0 };
+    assert(mz_zip_reader_init_file(&zip, path, 0));
+    struct ModImportZipPreflight result = mod_import_zip_preflight(&zip);
+    mz_zip_reader_end(&zip);
+    unlink(path);
+    return result;
+}
+
+int main(void) {
+    char path[256];
+    mz_zip_archive zip;
+
+    make_path(path, sizeof(path), "lua");
+    write_zip_start(&zip, path);
+    assert(mz_zip_writer_add_mem(&zip, "Pack/main.lua", "return true", 11, MZ_BEST_SPEED));
+    assert(mz_zip_writer_add_mem(&zip, "Pack/lib/helper.lua", "return 1", 8, MZ_BEST_SPEED));
+    assert(mz_zip_writer_add_mem(&zip, "Pack/actor.bin", "model", 5, MZ_BEST_SPEED));
+    write_zip_end(&zip);
+    struct ModImportZipPreflight result = scan(path);
+    assert(result.error == MOD_IMPORT_ZIP_PREFLIGHT_OK);
+    assert(result.is_lua && result.is_dynos);
+    assert(strcmp(result.lua_path, "Pack/") == 0);
+
+    make_path(path, sizeof(path), "dynos");
+    write_zip_start(&zip, path);
+    assert(mz_zip_writer_add_mem(&zip, "Characters/Peach/actor.bin", "model", 5, MZ_BEST_SPEED));
+    assert(mz_zip_writer_add_mem(&zip, "Characters/Peach/texture.tex", "texture", 7, MZ_BEST_SPEED));
+    write_zip_end(&zip);
+    result = scan(path);
+    assert(result.error == MOD_IMPORT_ZIP_PREFLIGHT_OK);
+    assert(!result.is_lua && result.is_dynos);
+
+    make_path(path, sizeof(path), "late-traversal");
+    write_zip_start(&zip, path);
+    assert(mz_zip_writer_add_mem(&zip, "Pack/main.lua", "return true", 11, MZ_BEST_SPEED));
+    assert(mz_zip_writer_add_mem(&zip, "../outside.lua", "return false", 12, MZ_BEST_SPEED));
+    write_zip_end(&zip);
+    result = scan(path);
+    assert(result.error == MOD_IMPORT_ZIP_PREFLIGHT_UNSAFE_PATH);
+    assert(result.entry_index == 1);
+
+    make_path(path, sizeof(path), "too-many");
+    write_zip_start(&zip, path);
+    for (mz_uint i = 0; i <= MOD_IMPORT_MAX_ZIP_ENTRIES; ++i) {
+        char name[32];
+        snprintf(name, sizeof(name), "entry-%05u", i);
+        assert(mz_zip_writer_add_mem(&zip, name, "", 0, MZ_BEST_SPEED));
+    }
+    write_zip_end(&zip);
+    result = scan(path);
+    assert(result.error == MOD_IMPORT_ZIP_PREFLIGHT_TOO_MANY_ENTRIES);
+
+    puts("production ZIP preflight tests: passed");
+    return 0;
+}
