@@ -0,0 +1,64 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pc/gfx/gfx_metal_coopdx_shader.h"
+#include "pc/gfx/gfx_pc.h"
+
+void gfx_pc_precomp_shader(uint32_t rgb1, uint32_t alpha1,
+                           uint32_t rgb2, uint32_t alpha2, uint32_t flags) {
+    (void)rgb1; (void)alpha1; (void)rgb2; (void)alpha2; (void)flags;
+}
+
+int main(void) {
+    struct ColorCombiner cc = { 0 };
+    cc.cm.use_alpha = true;
+    cc.cm.use_fog = true;
+    cc.cm.texture_edge = true;
+    cc.cm.use_2cycle = true;
+    cc.cm.light_map = true;
+    cc.shader_commands[0] = SHADER_TEXEL0;
+    cc.shader_commands[1] = SHADER_INPUT_1;
+    cc.shader_commands[2] = SHADER_INPUT_2;
+    cc.shader_commands[3] = SHADER_INPUT_3;
+    cc.shader_commands[4] = SHADER_TEXEL0;
+    cc.shader_commands[5] = SHADER_INPUT_1;
+    cc.shader_commands[6] = SHADER_INPUT_2;
+    cc.shader_commands[7] = SHADER_INPUT_3;
+    cc.shader_commands[8] = SHADER_TEXEL1;
+    cc.shader_commands[9] = SHADER_0;
+    cc.shader_commands[10] = SHADER_1;
+    cc.shader_commands[11] = SHADER_COMBINED;
+    cc.shader_commands[12] = SHADER_TEXEL1;
+    cc.shader_commands[13] = SHADER_0;
+    cc.shader_commands[14] = SHADER_1;
+    cc.shader_commands[15] = SHADER_COMBINED;
+
+    struct GfxMetalCoopDXShaderInfo info;
+    char source[8192];
+    assert(gfx_metal_coopdx_build_shader(&cc, source, sizeof(source), &info));
+    assert(info.alpha && info.fog && info.texture_edge && info.two_cycle && info.light_map);
+    assert(info.features.num_inputs == 3);
+    assert(info.features.used_textures[0] && info.features.used_textures[1]);
+    assert(info.vertex_stride == (4u + 2u + 2u + 4u + 2u + 3u * 4u) * sizeof(float));
+    assert(info.attribute_count == 1u + 2u + 1u + 1u + 3u);
+    assert(strstr(source, "vertex VOut coopdx_vertex") != NULL);
+    assert(strstr(source, "fragment float4 coopdx_fragment") != NULL);
+    assert(strstr(source, "(texel0.rgb - in.input1.rgb) * in.input2.rgb + in.input3.rgb") != NULL);
+    assert(strstr(source, "combined.rgb") != NULL);
+    assert(strstr(source, "discard_fragment()") != NULL);
+    assert(strstr(source, "mix(combined.rgb,in.fog.rgb,in.fog.a)") != NULL);
+
+    struct GfxMetalCoopDXShaderKey key_a, key_b;
+    assert(gfx_metal_coopdx_shader_key(&cc, &key_a));
+    assert(gfx_metal_coopdx_shader_key(&cc, &key_b));
+    assert(gfx_metal_coopdx_shader_key_equal(&key_a, &key_b));
+    cc.shader_commands[0] = SHADER_TEXEL1;
+    assert(gfx_metal_coopdx_shader_key(&cc, &key_b));
+    assert(!gfx_metal_coopdx_shader_key_equal(&key_a, &key_b));
+
+    char tiny[16];
+    assert(!gfx_metal_coopdx_build_shader(&cc, tiny, sizeof(tiny), &info));
+    puts("CoopDX Metal combiner adapter tests: passed");
+    return 0;
+}
