+#ifndef GFX_METAL_COOPDX_SHADER_H
+#define GFX_METAL_COOPDX_SHADER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "gfx_cc.h"
+
