index 0000000000000000000000000000000000000000..8838e13a266943ed79ff9bfc7150ddbba0777f7a
--- /dev/null
+++ b/scripts/prepare_sdl2_ios.sh
@@ -0,0 +1,67 @@
+#!/bin/sh
+set -eu
+
+ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+SDL_DIR=${SDL2_SOURCE_DIR:-"$ROOT/lib/SDL2-source"}
+SDL_VERSION=2.32.10
+SDL_ARCHIVE_SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
+SDL_ARCHIVE_URL="https://github.com/libsdl-org/SDL/releases/download/release-${SDL_VERSION}/SDL2-${SDL_VERSION}.tar.gz"
+MARKER=.coopdx-sdl2-source
+
+sha256() {
+    if command -v shasum >/dev/null 2>&1; then
+        shasum -a 256 "$1" | awk '{print $1}'
+    elif command -v sha256sum >/dev/null 2>&1; then
+        sha256sum "$1" | awk '{print $1}'
+    else
+        echo "Error: shasum or sha256sum is required." >&2
+        exit 1
+    fi
+}
+
+if [ -d "$SDL_DIR" ]; then
+    if [ -f "$SDL_DIR/$MARKER" ] && grep -Fxq "SDL ${SDL_VERSION} ${SDL_ARCHIVE_SHA256}" "$SDL_DIR/$MARKER"; then
+        echo "SDL ${SDL_VERSION} already prepared at $SDL_DIR"
+        exit 0
+    fi
+    echo "Error: refusing to replace unmarked or differently versioned SDL source: $SDL_DIR" >&2
+    echo "Move it aside yourself, then rerun this script." >&2
+    exit 1
+fi
+
+if [ -n "${SDL2_ARCHIVE:-}" ]; then
+    ARCHIVE=$SDL2_ARCHIVE
+    CLEAN_ARCHIVE=0
+else
+    TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/coopdx-sdl2.XXXXXX")
+    trap 'rm -rf "$TMP_ROOT"' EXIT HUP INT TERM
+    ARCHIVE="$TMP_ROOT/SDL2-${SDL_VERSION}.tar.gz"
+    curl --fail --location --retry 3 --output "$ARCHIVE" "$SDL_ARCHIVE_URL"
+    CLEAN_ARCHIVE=1
+fi
+
+ACTUAL_SHA256=$(sha256 "$ARCHIVE")
+if [ "$ACTUAL_SHA256" != "$SDL_ARCHIVE_SHA256" ]; then
+    echo "Error: SDL archive checksum mismatch." >&2
+    echo "Expected: $SDL_ARCHIVE_SHA256" >&2
+    echo "Actual:   $ACTUAL_SHA256" >&2
+    exit 1
+fi
+
+if [ "$CLEAN_ARCHIVE" = 1 ]; then
+    SOURCE_TMP="$TMP_ROOT/SDL2-${SDL_VERSION}"
+else
+    TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/coopdx-sdl2.XXXXXX")
+    trap 'rm -rf "$TMP_ROOT"' EXIT HUP INT TERM
+    SOURCE_TMP="$TMP_ROOT/SDL2-${SDL_VERSION}"
+fi
+tar -xzf "$ARCHIVE" -C "$TMP_ROOT"
+if [ ! -f "$SOURCE_TMP/CMakeLists.txt" ] || ! grep -Eq '#define SDL_MAJOR_VERSION[[:space:]]+2([[:space:]]|$)' "$SOURCE_TMP/include/SDL_version.h" || ! grep -Eq '#define SDL_MINOR_VERSION[[:space:]]+32([[:space:]]|$)' "$SOURCE_TMP/include/SDL_version.h" || ! grep -Eq '#define SDL_PATCHLEVEL[[:space:]]+10([[:space:]]|$)' "$SOURCE_TMP/include/SDL_version.h"; then
+    echo "Error: downloaded archive does not contain the expected SDL ${SDL_VERSION} source." >&2
+    exit 1
+fi
+
+mkdir -p "$(dirname -- "$SDL_DIR")"
+mv "$SOURCE_TMP" "$SDL_DIR"
+printf 'SDL %s %s\n' "$SDL_VERSION" "$SDL_ARCHIVE_SHA256" > "$SDL_DIR/$MARKER"
+echo "Prepared verified SDL ${SDL_VERSION} source at $SDL_DIR"
