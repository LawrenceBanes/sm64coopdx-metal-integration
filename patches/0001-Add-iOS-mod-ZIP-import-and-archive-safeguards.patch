+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "pc/mods/mod_import_path.h"
+
+static void expect_safe(const char *path, bool expected) {
+    bool actual = mod_import_zip_path_is_safe(path);
+    if (actual != expected) {
+        fprintf(stderr, "path safety mismatch for '%s': got %d, expected %d\n",
+                path ? path : "(null)", actual, expected);
+        assert(actual == expected);
+    }
+}
+
+int main(void) {
+    expect_safe("main.lua", true);
+    expect_safe("folder/main.lua", true);
+    expect_safe("./mod/main.lua", true);
+    expect_safe("actors/", true);
+    expect_safe("", false);
+    expect_safe(NULL, false);
+    expect_safe("/absolute/file.lua", false);
+    expect_safe("\\absolute\\file.lua", false);
+    expect_safe("../escape.lua", false);
+    expect_safe("mod/../../escape.lua", false);
+    expect_safe("mod\\main.lua", false);
+    expect_safe("C:/escape.lua", false);
+    expect_safe("mod//main.lua", false);
+    expect_safe("bad\nname.lua", false);
+
+    char too_long[MOD_IMPORT_MAX_ZIP_PATH + 2];
+    memset(too_long, 'a', sizeof(too_long) - 1);
+    too_long[sizeof(too_long) - 1] = '\0';
+    expect_safe(too_long, false);
+
+    puts("mod import path validation: passed");
+    return 0;
+}
