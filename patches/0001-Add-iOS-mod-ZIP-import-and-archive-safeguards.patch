+        BOOL accessed = [url startAccessingSecurityScopedResource];
+        NSString *tempName = [NSString stringWithFormat:@"sm64coopdx-import-%@.zip", NSUUID.UUID.UUIDString];
+        NSString *tempPath = [NSTemporaryDirectory() stringByAppendingPathComponent:tempName];
+
+        NSError *error = nil;
+        [[NSFileManager defaultManager] copyItemAtURL:url
+                                                toURL:[NSURL fileURLWithPath:tempPath]
+                                                error:&error];
+        if (accessed) {
+            [url stopAccessingSecurityScopedResource];
+        }
+
+        if (!error && !gfx_sdl_queue_file_import(tempPath.fileSystemRepresentation)) {
+            error = [NSError errorWithDomain:@"com.sm64coopdx.ios"
+                                        code:1
+                                    userInfo:@{NSLocalizedDescriptionKey: @"The game could not queue the selected mod for import."}];
+        }
+        if (error) {
+            [[NSFileManager defaultManager] removeItemAtPath:tempPath error:nil];
+            NSLog(@"[sm64coopdx] Mod ZIP import could not be queued: %@", error.localizedDescription);
+        }
+    }
+    sModPickerActive = false;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+    sModPickerActive = false;
+}
+
+@end
+
+static SM64ModPickerDelegate *sModPickerDelegate = nil;
+
+void platform_ios_open_mod_picker(void) {
+    if (sModPickerActive) return;
+    sModPickerActive = true;
+
+    if (!sModPickerDelegate) {
+        sModPickerDelegate = [[SM64ModPickerDelegate alloc] init];
+    }
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        UIDocumentPickerViewController *picker =
+            [[UIDocumentPickerViewController alloc] initWithDocumentTypes:@[@"com.pkware.zip-archive"]
+                                                                  inMode:UIDocumentPickerModeImport];
+        picker.delegate = sModPickerDelegate;
+        picker.allowsMultipleSelection = NO;
+
+        UIViewController *rootVC = [UIApplication sharedApplication].keyWindow.rootViewController;
+        if (rootVC) {
+            [rootVC presentViewController:picker animated:YES completion:nil];
+        } else {
+            sModPickerActive = false;
+        }
+    });
+}
+
 #endif
