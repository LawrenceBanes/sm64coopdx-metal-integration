+/* UIKit presents the Files picker on the main queue. Queue the selected path
+ * back to SDL so mod/DynOS refreshes run on the game's event thread. */
+bool gfx_sdl_queue_file_import(const char *path) {
+    if (!path || !path[0] || sFileImportEvent == (Uint32)-1) return false;
+
+    char *path_copy = SDL_strdup(path);
+    if (!path_copy) return false;
+
+    SDL_Event event = { 0 };
+    event.type = sFileImportEvent;
+    event.user.type = sFileImportEvent;
+    event.user.data1 = path_copy;
+    if (SDL_PushEvent(&event) != 1) {
+        SDL_free(path_copy);
+        return false;
+    }
+    return true;
+}
