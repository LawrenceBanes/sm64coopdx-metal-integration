diff --git a/src/pc/mods/mod_import_path.h b/src/pc/mods/mod_import_path.h
new file mode 100644
index 0000000000000000000000000000000000000000..51ecb7e02ea54c2ff4bb27f87df50d4758e2004d
--- /dev/null
+++ b/src/pc/mods/mod_import_path.h
@@ -0,0 +1,37 @@
+#ifndef MOD_IMPORT_PATH_H
+#define MOD_IMPORT_PATH_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+
+#define MOD_IMPORT_MAX_ZIP_PATH 4095
+
+/* ZIP names must be relative slash-separated paths. A leading "./" is kept
+ * compatible with common ZIP tools; parent traversal and platform-specific
+ * separators are rejected before the name is joined to an install root. */
+static inline bool mod_import_zip_path_is_safe(const char *path) {
+    if (!path || !path[0] || path[0] == '/' || path[0] == '\\') return false;
+
+    size_t length = 0;
+    while (length <= MOD_IMPORT_MAX_ZIP_PATH && path[length]) ++length;
+    if (length == 0 || length > MOD_IMPORT_MAX_ZIP_PATH) return false;
+
+    size_t component_start = 0;
+    for (size_t i = 0; i <= length; ++i) {
+        unsigned char ch = (unsigned char)path[i];
+        if (ch == '\\' || ch == ':' || (ch != '\0' && (ch < 0x20 || ch == 0x7f))) return false;
+
+        if (ch == '/' || ch == '\0') {
+            size_t component_length = i - component_start;
+            if (component_length == 0) return false;
+            if (component_length == 2 && path[component_start] == '.' && path[component_start + 1] == '.') return false;
+            component_start = i + 1;
+            if (ch == '/' && i + 1 == length) return true;
+        }
+    }
+
+    return true;
+}
+
+#endif
